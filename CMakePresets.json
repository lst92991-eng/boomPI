{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "rv1106-release",
      "displayName": "RV1106 release",
      "description": "Luckfox SDK plus dependencies in third_party.",
      "binaryDir": "${sourceDir}/build/rv1106-release",
      "toolchainFile": "${sourceDir}/client/cmake/toolchains/rv1106.cmake",
      "cacheVariables": {
        "BOOMPI_STRICT_WARNINGS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "rv1106-release",
      "configurePreset": "rv1106-release"
    }
  ]
}
