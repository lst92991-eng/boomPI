{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BOOMPI_BUILD_UI_SIMULATOR": "OFF",
        "BOOMPI_BUILD_TESTS": "ON",
        "BOOMPI_STRICT_WARNINGS": "ON",
        "BOOMPI_TARGET_RV1106": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "host-debug",
      "inherits": "host-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-release",
      "inherits": "host-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "rv1106-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/client/cmake/toolchains/rv1106.cmake",
      "cacheVariables": {
        "BOOMPI_BUILD_TESTS": "OFF",
        "BOOMPI_STRICT_WARNINGS": "OFF",
        "BOOMPI_TARGET_RV1106": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "rv1106-release",
      "displayName": "RV1106 teaching release",
      "description": "Complete board client; local dependency paths come from BOOMPI_* environment variables or CMakeUserPresets.json.",
      "inherits": "rv1106-base",
      "cacheVariables": {
        "BOOMPI_BOOST_INCLUDE_DIR": "$env{BOOMPI_BOOST_INCLUDE_DIR}",
        "BOOMPI_LVGL_ROOT": "$env{BOOMPI_LVGL_ROOT}",
        "BOOMPI_OPENBLAS_LIBRARY": "$env{BOOMPI_OPENBLAS_LIBRARY}",
        "BOOMPI_OPENSSL_ROOT": "$env{BOOMPI_OPENSSL_ROOT}",
        "BOOMPI_ROCKCHIP_3A_AEC_LIBRARY": "$env{BOOMPI_ROCKCHIP_3A_AEC_LIBRARY}",
        "BOOMPI_ROCKCHIP_3A_COMMON_LIBRARY": "$env{BOOMPI_ROCKCHIP_3A_COMMON_LIBRARY}",
        "BOOMPI_ROCKCHIP_3A_INCLUDE_DIR": "$env{BOOMPI_ROCKCHIP_3A_INCLUDE_DIR}",
        "BOOMPI_SNOWBOY_INCLUDE_DIR": "$env{BOOMPI_SNOWBOY_INCLUDE_DIR}",
        "BOOMPI_SNOWBOY_LIBRARY": "$env{BOOMPI_SNOWBOY_LIBRARY}",
        "BOOMPI_WEBRTC_VAD_INCLUDE_DIR": "$env{BOOMPI_WEBRTC_VAD_INCLUDE_DIR}",
        "BOOMPI_WEBRTC_VAD_LIBRARY": "$env{BOOMPI_WEBRTC_VAD_LIBRARY}",
        "BOOMPI_STRICT_WARNINGS": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "configuration": "Debug"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "configuration": "Release"
    },
    {
      "name": "rv1106-release",
      "configurePreset": "rv1106-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
