#!/bin/sh
# BusyBox 教学版入口：一个进程、三次有限重启、更新启动失败自动回滚。

umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LD_LIBRARY_PATH=/oem/usr/lib:/usr/lib:/lib
export PATH LD_LIBRARY_PATH
BASE=/userdata/boompi
APP=$BASE/bin/boompi-client
CONF=$BASE/config/client.env
LOG=$BASE/log/client.log
PID=/run/boompi-client.pid
CHILD_PID=/run/boompi-client-child.pid
LOCK=/run/boompi-clientctl.lock

fail() { echo "boompi-clientctl: $*" >&2; exit 1; }
prepare() {
  mkdir -p "$BASE/bin" "$BASE/config" "$BASE/log" /run || fail 'cannot create directories'
  chmod 700 "$BASE" "$BASE/config" "$BASE/log"
  if [ ! -e "$CONF" ]; then
    device_id=$(cat /proc/sys/kernel/random/uuid 2>/dev/null) || fail 'cannot create device id'
    cat > "$CONF" <<EOF
BOOMPI_DEVICE_ID=$device_id
BOOMPI_VOLUME_PERCENT=60
BOOMPI_SNOWBOY_SENSITIVITY=0.7
BOOMPI_VAD_MIN_DBFS=-30
BOOMPI_BARGE_MIN_DBFS=-25
BOOMPI_CAPTURE_LEFT_POLARITY=1
BOOMPI_CAPTURE_RIGHT_POLARITY=1
EOF
    echo "boompi-clientctl: created $CONF"
  fi
  [ ! -f "$CONF" ] || chmod 600 "$CONF"
}
load_config() {
  [ -r "$CONF" ] || fail "missing $CONF"
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in ''|'#'*) continue ;; *=*) ;; *) fail 'invalid config line' ;; esac
    name=${line%%=*}; value=${line#*=}
    case $name in BOOMPI_*) export "$name=$value" ;; *) fail "invalid config key: $name" ;; esac
  done < "$CONF"
}
running() {
  [ -r "$PID" ] || return 1
  RUN_PID=$(cat "$PID")
  case $RUN_PID in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$RUN_PID" 2>/dev/null && grep -q 'boompi-clientctl' "/proc/$RUN_PID/cmdline" 2>/dev/null
}
stop_child() { [ -z "$CHILD" ] || { kill "$CHILD" 2>/dev/null; wait "$CHILD" 2>/dev/null; rm -f "$CHILD_PID"; }; }
take_lock() {
  mkdir "$LOCK" 2>/dev/null || fail 'another client control operation is running'
  trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
}
needs_provision() {
  [ "$(cat /sys/class/net/eth0/carrier 2>/dev/null)" != 1 ] &&
    ! grep -q '^# boomPI-managed$' /etc/wpa_supplicant.conf 2>/dev/null
}

run_provision() {
  restore=${1:-0}
  trap 'stop_child; rm -f "$PID"; exit 0' HUP INT TERM
  prepare
  /usr/sbin/boompi-provision &
  CHILD=$!; echo "$CHILD" > "$CHILD_PID"; wait "$CHILD"; code=$?
  rm -f "$CHILD_PID" "$PID"; CHILD=
  if [ "$code" -eq 0 ] || [ "$restore" -eq 1 ]; then start 1; fi
  exit "$code"
}

launch_provision() {
  restore=${1:-0}; prepare
  [ ! -f "$LOG" ] || [ "$(wc -c < "$LOG")" -le 1048576 ] || mv -f "$LOG" "$LOG.1"
  nohup "$0" _provision "$restore" >> "$LOG" 2>&1 & echo $! > "$PID"
  sleep 1; running || fail "provisioning failed; inspect $LOG"
  echo "boompi provisioning started (pid $RUN_PID)"
}

run_loop() {
  trap 'stop_child; rm -f "$PID"; exit 0' HUP INT TERM
  load_config
  tries=0
  while [ "$tries" -lt 3 ]; do
    "$APP" --voice-loop &
    CHILD=$!; echo "$CHILD" > "$CHILD_PID"; wait "$CHILD"; code=$?; rm -f "$CHILD_PID"; CHILD=
    [ "$code" -eq 0 ] && break
    tries=$((tries + 1)); [ "$tries" -lt 3 ] && sleep "$tries"
  done
  rm -f "$PID"
  exit "$code"
}

launch_client() {
  checks=${1:-1}
  [ ! -f "$LOG" ] || [ "$(wc -c < "$LOG")" -le 1048576 ] || mv -f "$LOG" "$LOG.1"
  nohup "$0" _run >> "$LOG" 2>&1 & echo $! > "$PID"
  checked=0
  while [ "$checked" -lt "$checks" ]; do
    sleep 1
    checked=$((checked + 1))
    if ! running; then rm -f "$PID" "$CHILD_PID"; return 1; fi
  done
  return 0
}

start() {
  skip_provision=${1:-0}
  prepare
  running && { echo "boompi-client is running (pid $RUN_PID)"; return; }
  rm -f "$PID"; [ -x "$APP" ] || fail 'client is not installed'
  load_config; "$APP" --check-config >/dev/null || fail 'configuration check failed'
  if [ "$skip_provision" -eq 0 ] && needs_provision; then launch_provision 0; return; fi
  launch_client 1 || fail "start failed; inspect $LOG"
  echo "boompi-client started (pid $RUN_PID)"
}
stop() {
  if ! running; then rm -f "$PID"; echo 'boompi-client is stopped'; return; fi
  kill "$RUN_PID" 2>/dev/null || true
  waited=0; while running && [ "$waited" -lt 8 ]; do sleep 1; waited=$((waited + 1)); done
  if running; then
    child=$(cat "$CHILD_PID" 2>/dev/null || true)
    case $child in ''|*[!0-9]*) ;; *) kill -KILL "$child" 2>/dev/null || true ;; esac
    kill -KILL "$RUN_PID" 2>/dev/null || true
  fi
  rm -f "$PID" "$CHILD_PID"; echo 'boompi-client stopped'
}
provision() {
  [ -d /sys/class/net/wlan0 ] ||
    fail 'Wi-Fi interface wlan0 is unavailable; client remains running'
  for tool in hostapd dnsmasq python3; do
    command -v "$tool" >/dev/null 2>&1 ||
      fail "Wi-Fi provisioning needs $tool; client remains running"
  done
  was_running=0; running && was_running=1
  [ "$was_running" -eq 0 ] || stop
  launch_provision "$was_running"
}
update() {
  source=$1
  case $source in /*) ;; *) fail 'update needs an absolute binary path' ;; esac
  [ -f "$source" ] && [ -x "$source" ] || fail 'update binary is invalid'
  prepare; load_config; "$source" --check-config >/dev/null || fail 'new binary check failed'
  was_running=0; running && was_running=1
  rm -f "$APP.new"
  cp "$source" "$APP.new" && chmod 755 "$APP.new" || {
    rm -f "$APP.new"; fail 'copy failed'
  }
  have_backup=0
  if [ -f "$APP" ]; then
    rm -f "$APP.bak.new"
    cp "$APP" "$APP.bak.new" && chmod 755 "$APP.bak.new" || {
      rm -f "$APP.new" "$APP.bak.new"; fail 'backup failed'
    }
    mv -f "$APP.bak.new" "$APP.bak" || {
      rm -f "$APP.new" "$APP.bak.new"; fail 'backup install failed'
    }
    have_backup=1
  fi
  [ "$was_running" -eq 0 ] || stop
  if ! mv -f "$APP.new" "$APP"; then
    rm -f "$APP.new"
    [ "$was_running" -eq 0 ] || launch_client 4 || true
    fail 'install failed'
  fi
  echo "boompi-client installed; backup=$APP.bak"
  [ "$was_running" -eq 0 ] && return
  if launch_client 4; then
    echo "boompi-client started (pid $RUN_PID)"
    return
  fi
  [ "$have_backup" -eq 1 ] || fail 'new binary failed and no backup is available'
  mv -f "$APP.bak" "$APP" || fail 'new binary failed and rollback install failed'
  if launch_client 4; then
    fail 'new binary failed; previous version restored'
  fi
  fail 'new binary failed; previous version restored but restart failed'
}

case ${1:-} in
  _run) run_loop ;;
  _provision) run_provision "${2:-0}" ;;
  *)
    take_lock
    case ${1:-} in
      start) start ;;
      stop) stop ;;
      restart) stop; start ;;
      provision) provision ;;
      status) running && echo "boompi-client is running (pid $RUN_PID)" || echo 'boompi-client is stopped' ;;
      log) tail -n 100 "$LOG" ;;
      update) [ "$#" -eq 2 ] || fail 'usage: boompi-clientctl update /absolute/path'; update "$2" ;;
      *) echo 'usage: boompi-clientctl start|stop|restart|status|log|update|provision' >&2; exit 2 ;;
    esac
    ;;
esac
